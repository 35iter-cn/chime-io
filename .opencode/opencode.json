{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@chime-io/plugin-opencode@file:./packages/opencode"
  ],
  "provider": {
    "cline": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cline",
      "options": {
        "baseURL": "https://api.cline.bot/api/v1",
        "apiKey": "{env:CLINE_API_KEY}"
      },
      "models": {
        "cline-pass/glm-5.2": {
          "name": "GLM 5.2",
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
